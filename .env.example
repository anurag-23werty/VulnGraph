# ==============================================================================
# VulnGraph Environment Configuration
# ==============================================================================

# FalkorDB Graph Database (Docker container on port 6379, UI on 3000)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=vulngraph

# Groq AI Inference (Ultra-low latency LLM for agentic tool use)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# FastAPI Application Server Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Optional Webhook for Ticket Notification Simulation (Slack / Discord)
SLACK_WEBHOOK_URL=
